# Copiá a .env y completá lo que uses.
# Sin estas keys el panel publica en modo simulado (seguro para demos).

API_PORT=43125
PUBLIC_WEB_URL=http://127.0.0.1:43124

# ——— Mercado Libre Developers ———
# https://developers.mercadolibre.com.ar/
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://127.0.0.1:43125/api/ml/callback
ML_SITE_ID=MLA
# free | silver | gold | gold_premium (según pack de la cuenta)
ML_LISTING_TYPE=free
# Contacto del aviso (seller_contact). Si vacío, se usa agency de listings.json.
# WhatsApp: country_code2=54 + phone2=dígitos sin + (ej. 5492916450560 → phone2 92916450560)
ML_CONTACT_NAME=
ML_CONTACT_EMAIL=
ML_CONTACT_PHONE=
ML_CONTACT_WHATSAPP=
ML_CONTACT_AREA_CODE=
ML_CONTACT_PHONE_LOCAL=

# ——— Argenprop (credenciales que te da comercial / partner) ———
ARGENPROP_API_BASE=https://apiw.argenprop.com
ARGENPROP_USR=
ARGENPROP_PSD=
ARGENPROP_ID_VENDEDOR=
ARGENPROP_ID_ORIGEN=
ARGENPROP_SISTEMA_ORIGEN_ID=

# ——— Instagram / Meta ———
# https://developers.facebook.com/
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://127.0.0.1:43125/api/ig/callback
IG_USER_ID=
# Alternativa sin OAuth interactivo (token de página de larga duración):
IG_PAGE_ACCESS_TOKEN=
